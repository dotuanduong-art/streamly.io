# Backend host only: no /api and no trailing slash.
VITE_API_URL=https://api.example.com
# Movies, genres, and mock-only similar movies.
VITE_USE_MOCK=true
# Login, register, and current-user verification only.
VITE_USE_MOCK_AUTH=true
# My List, watch history, and profile only.
VITE_USE_MOCK_USER_DATA=true
