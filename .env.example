# Host only, no /api or /v1. localhost:7160 works only on the backend machine.
# Use a reachable deployment, tunnel, or LAN host for integration from another machine.
VITE_API_URL=https://localhost:7160
# Movie/genre/similar mock switch.
VITE_USE_MOCK=true
# Independent Auth + My List mock switch; backend endpoints do not exist yet.
VITE_USE_MOCK_AUTH=true
